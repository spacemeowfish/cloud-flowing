MODEL_PROVIDER=rkllm
RKLLM_SERVER_URL=http://127.0.0.1:8080/v1
RKLLM_MODEL_NAME=rkllm
RKLLM_TIMEOUT_SECONDS=30
RKLLM_QUEUE_TIMEOUT_SECONDS=2
RKLLM_MAX_CONCURRENCY=1
RKLLM_MAX_CONTEXT=4096
RKLLM_MAX_NEW_TOKENS=512

MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_BASE_URL=https://api.example.com/v1
MODEL_FALLBACK_NAME=qwen2.5-3b-instruct
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_TIMEOUT_SECONDS=30

AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# 认证已统一由若依网关承担（RUOYI-AUTH-GATEWAY-001，见 deployment/ruoyi-gateway/）；
# 旧"环境变量开发者密码门"已随 ADR 0007 退役，不再使用。
AGENT_DATABASE_PATH=/var/lib/agent-platform/agent_platform.db
AGENT_AUDIT_DIR=/var/log/agent-platform/audit
AGENT_AUTHORIZED_FILE_ROOTS=/var/lib/agent-platform/authorized_files;/opt/agent-platform/demo_files
AGENT_KNOWLEDGE_ROOTS=/var/lib/agent-platform/knowledge;/opt/agent-platform/demo_docs
AGENT_MEETING_OUTPUT_DIR=/var/lib/agent-platform/meeting_notes
AGENT_FILE_OPEN_ENABLED=false
AGENT_NETWORK_AVAILABLE=true
AGENT_TIMEZONE=Asia/Shanghai

RKLLM_MODEL_PATH=/opt/agent-platform/models/qwen2.5-3b-instruct-w8a8-rk3588.rkllm
RKLLM_SERVER_HOST=127.0.0.1
RKLLM_SERVER_PORT=8080
RKLLM_ALLOW_INPROCESS_FREQ=0
RKLLM_LOG_LEVEL=1
LD_LIBRARY_PATH=/opt/agent-platform/vendor/rkllm/lib
