MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=qwen2.5-3b-instruct
MODEL_DIGEST=unknown
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_THINKING_ENABLED=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_NEW_TOKENS=512
# Output token ceiling for the argument-extraction stage (intent classification
# stays at a compact 192). Raise it when long text_polish inputs get truncated.
AGENT_INTENT_EXTRACTION_MAX_TOKENS=512
RKLLM_SERVER_URL=http://127.0.0.1:8080/v1
RKLLM_MODEL_NAME=rkllm
RKLLM_MODEL_DIGEST=unknown
RKLLM_TIMEOUT_SECONDS=30
RKLLM_QUEUE_TIMEOUT_SECONDS=2
RKLLM_MAX_CONCURRENCY=1
RKLLM_MAX_CONTEXT=4096
RKLLM_MAX_NEW_TOKENS=512
LLAMACPP_SERVER_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL_NAME=local-model
LLAMACPP_MODEL_DIGEST=unknown
LLAMACPP_TIMEOUT_SECONDS=120
LLAMACPP_QUEUE_TIMEOUT_SECONDS=2
LLAMACPP_THREADS=4
LLAMACPP_CONTEXT_SIZE=2048
LLAMACPP_MAX_TOKENS=256
LLAMACPP_BATCH_SIZE=256
LLAMACPP_PARALLEL=1
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_BASE_URL=https://api.example.com/v1
MODEL_FALLBACK_NAME=qwen2.5-3b-instruct
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_TIMEOUT_SECONDS=30
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# RuoYi gateway auth (contract: docs/contracts/ruoyi-auth-gateway.md). The secret
# must equal RuoYi token.secret (base64 text decoding to >=64 bytes) and never
# enters Git; without it every request fails closed with 401.
RUOYI_JWT_SECRET=
RUOYI_REDIS_URL=redis://localhost:6379/0
AGENT_DATABASE_PATH=./data/agent_platform.db
AGENT_AUDIT_DIR=./logs/audit
AGENT_RETENTION_DAYS=30
# Receipt cache TTL for read-like tools; state-changing tools use the shorter
# mutation TTL below so a repeated "remind me again" intent is not swallowed.
AGENT_IDEMPOTENCY_TTL_SECONDS=3600
AGENT_MUTATION_IDEMPOTENCY_TTL_SECONDS=120
AGENT_FILE_OPEN_ENABLED=false
# Canonical document source: one directory list feeds file search, knowledge
# QA, and meeting notes. Legacy AGENT_AUTHORIZED_FILE_ROOTS /
# AGENT_KNOWLEDGE_ROOTS still work as a fallback but are merged after this.
AGENT_DOCUMENT_ROOTS=["./data/documents","./demo_documents"]
AGENT_MEETING_OUTPUT_DIR=./data/meeting_notes
AGENT_TIMEZONE=Asia/Shanghai
TTS_PROVIDER=disabled
TTS_OUTPUT_DIR=./data/tts
TTS_MAX_CHARS=2000
TTS_KEEP_VERSIONS=3
ZIPVOICE_MODEL_DIR=./models/zipvoice
ZIPVOICE_VOCODER_PATH=./models/zipvoice/vocos_24khz.onnx
ZIPVOICE_REFERENCE_AUDIO_PATH=./models/zipvoice/reference.wav
ZIPVOICE_REFERENCE_TEXT=
ZIPVOICE_VOICES=[]
ZIPVOICE_DEFAULT_VOICE_ID=default
ZIPVOICE_NUM_THREADS=4
ZIPVOICE_SPEED=1.0
ZIPVOICE_NUM_STEPS=8
ZIPVOICE_POSTPROCESS=true
VOICE_ENABLED=false
VOICE_INPUT_DEVICE=
VOICE_MODEL_DIR=./models/faster-whisper-small
VOICE_CPU_THREADS=8
VOICE_NUM_WORKERS=1
VOICE_BEAM_SIZE=3
VOICE_VAD_ENABLED=true
VOICE_MAX_RECORDING_SECONDS=30
VOICE_MIN_RECORDING_SECONDS=0.4
VOICE_SILENCE_DBFS=-50
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=60
