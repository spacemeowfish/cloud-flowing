# RUOYI-AUTH-GATEWAY-001 Phase 5: local full-chain gateway (PC evidence, loopback only).
# Same shape as the Phase 6 production config: one entry, three locations.
# Path prefix "/agent-api" is stripped before FastAPI, mirroring the Phase 4
# dev-server proxy so API_BASE derivation in app.js works unchanged.

worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    log_format  gateway  '$remote_addr [$time_local] "$request" $status $body_bytes_sent';
    access_log  logs/access.log  gateway;
    error_log   logs/error.log   warn;

    # Modest shared rate limit (defensive baseline; Phase 6 tightens to login endpoints).
    limit_req_zone  $binary_remote_addr  zone=gateway:10m  rate=30r/s;

    server {
        listen       127.0.0.1:80;
        server_name  localhost;

        # 1) RuoYi frontend (production build, single-page app)
        root   D:/ruoyi-env/RuoYi-Vue2/dist;
        index  index.html;

        location / {
            limit_req zone=gateway burst=60 nodelay;
            try_files $uri $uri/ /index.html;
        }

        # 2) RuoYi backend API (prefix stripped)
        location /prod-api/ {
            limit_req zone=gateway burst=60 nodelay;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_pass http://127.0.0.1:8080/;
        }

        # 3) agent_platform FastAPI (JWT gate; SSE needs unbuffered streaming)
        location /agent-api/ {
            limit_req zone=gateway burst=60 nodelay;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_pass http://127.0.0.1:8000/;
        }
    }
}
